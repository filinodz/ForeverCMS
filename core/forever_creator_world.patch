+void DB2StorageBase::ExportWorldSource(std::string const& table) const
+{
+    std::string columns;
+    for (uint32 f = 0; f < _loadInfo->FieldCount; ++f)
+        columns += (f ? "," : "") + std::string("`") + _loadInfo->Fields[f].Name + "`";
+    WorldDatabaseTransaction trans = WorldDatabase.BeginTransaction();
+    trans->Append(Trinity::StringFormat("DELETE FROM `{}`", table).c_str());
+    std::string values;
+    auto quote = [](char const* value)
+    {
+        std::string text = value ? value : "";
+        WorldDatabase.EscapeString(text);
+        return "'" + text + "'";
+    };
+    for (uint32 id = _minId; id < _indexTableSize; ++id)
+    {
+        char const* data = _indexTable[id];
+        if (!data) continue;
+        std::string row;
+        for (uint32 f = 0; f < _loadInfo->FieldCount; ++f)
+        {
+            DB2FieldMeta const& field = _loadInfo->Fields[f];
+            if (f) row += ',';
+            switch (field.Type)
+            {
+                case FT_BYTE:
+                    row += field.IsSigned ? std::to_string(*reinterpret_cast<int8 const*>(data)) : std::to_string(*reinterpret_cast<uint8 const*>(data)); data += 1; break;
+                case FT_SHORT:
+                    row += field.IsSigned ? std::to_string(*reinterpret_cast<int16 const*>(data)) : std::to_string(*reinterpret_cast<uint16 const*>(data)); data += 2; break;
+                case FT_INT:
+                    row += field.IsSigned ? std::to_string(*reinterpret_cast<int32 const*>(data)) : std::to_string(*reinterpret_cast<uint32 const*>(data)); data += 4; break;
+                case FT_LONG:
+                    row += field.IsSigned ? std::to_string(*reinterpret_cast<int64 const*>(data)) : std::to_string(*reinterpret_cast<uint64 const*>(data)); data += 8; break;
+                case FT_FLOAT:
+                    row += Trinity::StringFormat("{}", *reinterpret_cast<float const*>(data)); data += 4; break;
+                case FT_STRING:
+                {
+                    LocalizedString const* localized = reinterpret_cast<LocalizedString const*>(data);
+                    char const* text = (*localized)[LOCALE_enUS];
+                    if (!text || !*text)
+                        for (char const* candidate : localized->Str)
+                            if (candidate && *candidate) { text = candidate; break; }
+                    row += quote(text); data += sizeof(LocalizedString); break;
+                }
+                case FT_STRING_NOT_LOCALIZED:
+                    row += quote(*reinterpret_cast<char const* const*>(data)); data += sizeof(char const*); break;
+                default: return;
+            }
+        }
+        values += (values.empty() ? "" : ",") + std::string("(") + row + ",0)";
+        if (values.size() > 60000)
+        {
+            trans->Append(Trinity::StringFormat("INSERT INTO `{}` ({},VerifiedBuild) VALUES {}", table, columns, values).c_str());
+            values.clear();
+        }
+    }
+    if (!values.empty()) trans->Append(Trinity::StringFormat("INSERT INTO `{}` ({},VerifiedBuild) VALUES {}", table, columns, values).c_str());
+    WorldDatabase.DirectCommitTransaction(trans);
+}
+
+std::vector<uint32> DB2StorageBase::LoadWorldOverrides(std::string const& table)
+{
+    std::vector<uint32> loaded;
+    std::string columns;
+    for (uint32 f = 0; f < _loadInfo->FieldCount; ++f)
+        columns += (f ? "," : "") + std::string("`") + _loadInfo->Fields[f].Name + "`";
+    QueryResult result = WorldDatabase.Query(Trinity::StringFormat("SELECT {} FROM `{}` ORDER BY VerifiedBuild", columns, table).c_str());
+    if (!result || result->GetFieldCount() != _loadInfo->FieldCount) return loaded;
+    uint32 indexField = _loadInfo->Meta->GetDbIndexField();
+    uint32 size = _loadInfo->Meta->GetRecordSize();
+    do
+    {
+        Field* fields = result->Fetch();
+        uint32 id = fields[indexField].GetUInt32();
+        if (!id || id > 2000000) continue;
+        if (id >= _indexTableSize)
+        {
+            uint32 newSize = id + 1;
+            char** next = new char*[newSize]();
+            std::copy_n(_indexTable, _indexTableSize, next);
+            delete[] _indexTable;
+            _indexTable = next; _indexTableSize = newSize;
+        }
+        char* record = new char[size]();
+        _worldDataPool.push_back(record);
+        char* cursor = record;
+        for (uint32 f = 0; f < _loadInfo->FieldCount; ++f)
+        {
+            switch (_loadInfo->Fields[f].Type)
+            {
+                case FT_BYTE: *reinterpret_cast<uint8*>(cursor) = uint8(fields[f].GetUInt64()); cursor += 1; break;
+                case FT_SHORT: *reinterpret_cast<uint16*>(cursor) = uint16(fields[f].GetUInt64()); cursor += 2; break;
+                case FT_INT: *reinterpret_cast<uint32*>(cursor) = uint32(fields[f].GetUInt64()); cursor += 4; break;
+                case FT_LONG: *reinterpret_cast<uint64*>(cursor) = fields[f].GetUInt64(); cursor += 8; break;
+                case FT_FLOAT: *reinterpret_cast<float*>(cursor) = fields[f].GetFloat(); cursor += 4; break;
+                case FT_STRING:
+                {
+                    LocalizedString* localized = reinterpret_cast<LocalizedString*>(cursor);
+                    char* text = nullptr;
+                    if (char* value = DB2DatabaseLoader::AddString(const_cast<char const**>(&text), fields[f].GetStringView())) _stringPool.push_back(value);
+                    for (char const*& locale : localized->Str) locale = text ? text : "";
+                    cursor += sizeof(LocalizedString); break;
+                }
+                case FT_STRING_NOT_LOCALIZED:
+                {
+                    char const** text = reinterpret_cast<char const**>(cursor);
+                    if (char* value = DB2DatabaseLoader::AddString(text, fields[f].GetStringView())) _stringPool.push_back(value);
+                    else *text = "";
+                    cursor += sizeof(char const*); break;
+                }
+                default: break;
+            }
+        }
+        ASSERT(cursor - record == size);
+        _indexTable[id] = record; _minId = std::min(_minId, id);
+        loaded.push_back(id);
+    } while (result->NextRow());
+    return loaded;
+}
